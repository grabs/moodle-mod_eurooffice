{{!
    @template mod_eurooffice/content

    Displays eurooffice view page

    Example context (json):
    {
        "id" : 46,
        "cmid" : 255
    }

}}
<button type="button" title="test" class="euroofficemodal btn btn-primary btn-sm me-2 px-1" data-bs-toggle="modal" data-bs-target="#euroofficemodal_{{id}}">
    <i class="fa fa-expand fa-lg fa-fw" aria-hidden="true"></i>
</button>
<div id="office-inline-anker">
    <div class="eurooffice-inline-container">
        <!-- The EuroOffice editor will be rendered here. -->
        <div id="eurooffice-editor-{{cmid}}"> </div>
    </div>
</div>

<div class="euroofficemodal modal fade" id="euroofficemodal_{{id}}">
    <div class="modal-dialog mw-100 h-100 m-0">
        <div class="modal-content h-100">

            <!-- Modal Header -->
            <div class="modal-header d-flex justify-content-between border-0 py-1">
                <button type="button" class="close-button btn btn-primary btn-sm" data-bs-dismiss="modal" title="TEST" >
                    <i class="fa fa-compress fa-lg" aria-hidden="true"> </i>
                </button>
            </div>
            <!-- Modal body -->
            <div id="office-modal-anker" class="modal-body pt-1">
                <!-- The document editor is moved here when the modal is shown. -->
            </div>
        </div>
    </div>
</div>



{{#js}}
    require(['mod_eurooffice/resizeiframe'], function(resizeiframe) {
        resizeiframe.init(15);
        const myModal = document.querySelector('#euroofficemodal_{{id}}');

        myModal.addEventListener('show.bs.modal', () => {
            let officeContainer = document.querySelector('.eurooffice-inline-container');
            let targetContainer = document.querySelector('#office-modal-anker');
            targetContainer.appendChild(officeContainer);
            resizeiframe.init(60);
        });
        myModal.addEventListener('hide.bs.modal', () => {
            let officeContainer = document.querySelector('.eurooffice-inline-container');
            let targetContainer = document.querySelector('#office-inline-anker');
            targetContainer.appendChild(officeContainer);
            resizeiframe.init(15);
        });
    });
{{/js}}
